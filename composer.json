{
	"name": "bwpn/best-web-push-notifications",
	"description": "Self-hosted web push notifications for WordPress. Forked from Perfecty Push Notifications.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Rowinson Gallego (Perfecty, original author)",
			"homepage": "https://github.com/rwngallego"
		},
		{
			"name": "Best Web Push Notifications contributors"
		}
	],
	"require": {
		"php": ">=8.2",
		"minishlink/web-push": "^11.0",
		"nyholm/psr7": "^1.8"
	},
	"require-dev": {
		"brianhenryie/strauss": "^0.32",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/wp-cli-stubs": "^2.11",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.3",
		"phpunit/phpunit": "^9.6",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.1",
		"wp-phpunit/wp-phpunit": "^6.8 || ^7.0",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true,
			"php-http/discovery": false
		},
		"platform": {
			"php": "8.2.0"
		},
		"sort-packages": true
	},
	"extra": {
		"strauss": {
			"target_directory": "vendor-prefixed",
			"namespace_prefix": "BWPN\\Vendor\\",
			"classmap_prefix": "BWPN_Vendor_",
			"constant_prefix": "BWPN_VENDOR_",
			"delete_vendor_packages": false
		}
	},
	"scripts": {
		"prefix-namespaces": [
			"strauss --info"
		],
		"post-install-cmd": [
			"@prefix-namespaces"
		],
		"post-update-cmd": [
			"@prefix-namespaces"
		],
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"analyse": "phpstan analyse --memory-limit=1G",
		"test": "phpunit"
	}
}
